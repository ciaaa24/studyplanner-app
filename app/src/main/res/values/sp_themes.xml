<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema aplikasi (mode terang saja agar warna tetap konsisten) -->
    <style name="Theme.StudyPlannerApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sp_primary</item>
        <item name="colorOnPrimary">@color/sp_on_primary</item>
        <item name="colorPrimaryContainer">@color/sp_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sp_primary</item>
        <item name="colorSecondaryContainer">@color/sp_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/sp_primary</item>
        <item name="colorSurface">@color/sp_surface</item>
        <item name="colorOnSurface">@color/sp_text</item>
        <item name="android:windowBackground">@color/sp_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Kolom isian -->
    <style name="SP.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/sp_surface</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="SP.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/sp_surface</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- Gaya teks. parent="" wajib: tanpa itu nama "SP.Xxx" dianggap mewarisi style "SP" yang tidak ada. -->
    <style name="SP.Heading" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sp_text</item>
    </style>

    <style name="SP.Section" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sp_text</item>
    </style>

    <style name="SP.Label" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sp_text</item>
    </style>

    <style name="SP.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/sp_text_secondary</item>
    </style>

    <style name="SP.Pill" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
